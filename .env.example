# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lxrn Compression Studio - Environment Variables

# ========== SERVER CONFIGURATION ==========
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# ========== FILE CONFIGURATION ==========
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file extensions (comma separated)
ALLOWED_EXTENSIONS=txt,json,csv,log,xml,html,css,js

# Temporary directory for file processing
TEMP_DIR=/tmp/lxrn

# ========== COMPRESSION CONFIGURATION ==========
# Default compression level: minimal, fastest, maximal, automatic
DEFAULT_COMPRESSION_LEVEL=automatic

# Window size for LZ77 (default: 32768)
WINDOW_SIZE=32768

# Maximum match length (default: 258)
MAX_MATCH_LENGTH=258

# Minimum match length (default: 3)
MIN_MATCH_LENGTH=3

# ========== CACHE CONFIGURATION ==========
# Enable/disable caching
CACHE_ENABLED=true

# Maximum number of items in cache
CACHE_MAX_SIZE=100

# Cache TTL in milliseconds (default: 1 hour)
CACHE_TTL=3600000

# Cache storage type: memory, redis
CACHE_STORAGE=memory

# Redis URL (if using redis cache)
# REDIS_URL=redis://localhost:6379

# ========== LOGGING CONFIGURATION ==========
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log format: json, pretty
LOG_FORMAT=json

# Log output: console, file, both
LOG_OUTPUT=console

# Log file path (if using file output)
# LOG_FILE=/var/log/lxrn/app.log

# ========== SECURITY CONFIGURATION ==========
# Enable CORS
CORS_ENABLED=true

# Allowed origins (comma separated, * for all)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# ========== PERFORMANCE CONFIGURATION ==========
# Enable compression optimization
OPTIMIZATION_ENABLED=true

# Use worker threads for compression
USE_WORKERS=true

# Number of worker threads (default: CPU cores)
WORKER_COUNT=4

# Enable streaming for large files
STREAMING_ENABLED=true

# Chunk size for streaming (in bytes)
STREAM_CHUNK_SIZE=65536

# ========== MONITORING CONFIGURATION ==========
# Enable metrics collection
METRICS_ENABLED=true

# Enable health checks
HEALTH_CHECK_ENABLED=true

# Health check interval (in milliseconds)
HEALTH_CHECK_INTERVAL=30000

# ========== INTEGRATION CONFIGURATION ==========
# API endpoint for external services
# API_URL=https://api.example.com

# API key for authentication
# API_KEY=your-api-key-here

# ========== FEATURE FLAGS ==========
# Enable experimental features
EXPERIMENTAL_ENABLED=false

# Enable web demo
WEB_DEMO_ENABLED=true

# Enable CLI tools
CLI_ENABLED=true

# ========== DEPLOYMENT CONFIGURATION ==========
# Docker container name
CONTAINER_NAME=lxrn-studio

# Kubernetes namespace
# KUBERNETES_NAMESPACE=default

# AWS region (if using AWS)
# AWS_REGION=us-east-1

# S3 bucket for file storage
# S3_BUCKET=lxrn-files

# ========== MAINTENANCE CONFIGURATION ==========
# Enable maintenance mode
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."

# Auto-cleanup interval (in hours)
AUTO_CLEANUP_INTERVAL=24

# Maximum age of temporary files (in hours)
TEMP_FILE_MAX_AGE=2
